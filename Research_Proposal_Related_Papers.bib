	annote = {Comment: 26 pages, 12 figures},
	file = {Full Text PDF:/Users/mej/Zotero/storage/BBGDBA4W/Dai et al. - 2021 - Personalized Popular Music Generation Using Imitation and Structure.pdf:application/pdf;Snapshot:/Users/mej/Zotero/storage/LA2MSCA8/2105.html:text/html},
